# Copie para .env na hospedagem. Nunca envie .env ao GitHub.
TELEGRAM_BOT_TOKEN=COLOQUE_O_TOKEN_NA_HOSPEDAGEM

# Planejador: ollama (local) ou openai
PLANNER_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OPENAI_API_KEY=

# Geração de imagens: Cloudflare Workers AI (cota gratuita diária)
IMAGE_PROVIDER=disabled
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Caminhos do Piper no servidor
PIPER_BIN=piper
PIPER_FEMALE_MODEL=
PIPER_MALE_MODEL=
FFMPEG_BIN=ffmpeg
