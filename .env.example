# Copie para .env na máquina/serviço de hospedagem. Nunca envie .env ao GitHub.
TELEGRAM_BOT_TOKEN=COLOQUE_O_TOKEN_NA_HOSPEDAGEM

# Planejador: ollama (local) ou openai
PLANNER_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# Necessário se PLANNER_PROVIDER=openai
OPENAI_API_KEY=

# Geração de imagens: desativada por padrão; habilite somente se aceitar cobrança da API
IMAGE_PROVIDER=disabled
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=low

# Caminhos do Piper no servidor
PIPER_BIN=piper
PIPER_FEMALE_MODEL=
PIPER_MALE_MODEL=
FFMPEG_BIN=ffmpeg
