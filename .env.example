# Segredos devem ser configurados no painel do Render, nunca no GitHub.
TELEGRAM_BOT_TOKEN=

# Planejador e imagens Cloudflare Workers AI (compartilham a cota diária gratuita)
PLANNER_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct
IMAGE_PROVIDER=cloudflare
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Vozes Piper e FFmpeg (ainda precisam ser instalados/configurados no servidor)
PIPER_BIN=piper
PIPER_FEMALE_MODEL=
PIPER_MALE_MODEL=
FFMPEG_BIN=ffmpeg
